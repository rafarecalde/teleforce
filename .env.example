# Marketing site (Astro). Copy to .env for local overrides. Never commit secrets.
#
# EA signup calls the portal for Stripe.js config, SetupIntent, and account creation.
# Defaults: astro dev → http://localhost:3000
#            production build → https://portal.tryteleforce.com
# Set this only if the portal lives somewhere else. The publishable key is fetched
# from the portal at runtime, so this site does not need a Stripe secret.
PUBLIC_PORTAL_URL=
