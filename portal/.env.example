# ── Teleforce client portal ────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real secrets.

# Stripe (TEST keys while developing — sk_test_...). Server-side only.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe Price IDs for the two EA commitments (read amounts from these — never
# hardcode dollar figures). Create the Prices in the Stripe dashboard.
STRIPE_PRICE_3MO=price_xxx_3month
STRIPE_PRICE_12MO=price_xxx_12month

# Resend API key (transactional email). https://resend.com
RESEND_API_KEY=re_xxx

# Secret used to sign magic-link + session JWTs (32+ random chars).
# Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Where ops/order notifications are sent.
OPS_EMAIL=ops@tryteleforce.com

# Public base URL of THIS portal app (no trailing slash).
# Local: http://localhost:3000  ·  Prod: https://portal.tryteleforce.com
APP_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
# Verified Resend sender. Must be on a domain you've verified in Resend.
# For quick local testing you can use: onboarding@resend.dev
MAIL_FROM=Teleforce <portal@tryteleforce.com>

# Stripe Billing Portal configuration ID (from `npm run setup:portal`).
# Restricts the portal to payment-method + invoices; no cancel / no plan switch.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxx
