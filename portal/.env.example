# Teleforce client portal. Copy to portal/.env.local. Never commit real keys.

# Public base URL of this app, no trailing slash.
# Local: http://localhost:3000  ·  Prod: https://portal.tryteleforce.com
APP_URL=http://localhost:3000

# Signs the session cookie. Required in production.
# Generate: openssl rand -base64 48
AUTH_SECRET=

# Stripe (same account the marketing signup uses). Test keys until go-live.
# Optional at signup. When a card is sent, signup creates a Customer + SetupIntent
# only — it does not charge, and it does not create a subscription or invoice.
# With no card, the account is stored with empty stripeCustomerId and
# defaultPaymentMethodId, and these keys are not required.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional alias if you prefer the Next public name. STRIPE_PUBLISHABLE_KEY wins.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Account store. LibSQL / Turso in production. Omit both for a local file DB
# at portal/data/teleforce.db (gitignored, not durable on Vercel).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sales-call sample account. Off by default. When "1", ?company=&name=&email=
# renders demo data and does not sign anyone in or read real accounts.
PREVIEW_MODE=

# Optional extra browser origins for signup, comma-separated.
# https://tryteleforce.com and http://localhost:4321 are always allowed.
SIGNUP_CORS_ORIGINS=

# Marketing site origin, no trailing slash. Used for the “complete signup” link.
MARKETING_URL=https://tryteleforce.com

# Kickoff scheduler after the client accepts a match. Inline Calendly widget.
# When unset or not an http(s) URL, uses the onboarding scheduler
# (ONBOARDING_CALENDLY_URL, default https://calendly.com/tryteleforce-sales).
KICKOFF_CALENDLY_URL=https://calendly.com/tryteleforce-sales

# Comma-separated portal logins that may open /admin.
# Defaults to rafael@recaldelaw.com. The address must be able to sign in.
ADMIN_EMAILS=

# Prefilled Partnership Manager on a match package. Ops can change them per client.
# Publish requires a name and email, from the form or from these.
DEFAULT_PARTNERSHIP_MANAGER_NAME=
DEFAULT_PARTNERSHIP_MANAGER_EMAIL=
# Match emails use RESEND_API_KEY and EMAIL_FROM.
# The internal acceptance alert uses SIGNUP_ALERT_TO when that is set.
# When SIGNUP_ALERT_TO is unset, the alert goes to sales@tryteleforce.com.

# Bearer token for /api/cron/match. Set the same value on Vercel as CRON_SECRET
# and in GitHub repo secrets as PORTAL_CRON_SECRET. The route stays closed if this is empty.
CRON_SECRET=

# Off unless this is exactly "true". When true, billing start creates a Stripe
# subscription on the saved card. Otherwise the sales alert says to charge in Stripe.
# No subscription is created while this is unset.
STRIPE_AUTO_BILLING=
# Price ids for that subscription only. Ignored while auto billing is off.
STRIPE_PRICE_3=
STRIPE_PRICE_12=

# Accepted-Terms email (Resend). Account creation still succeeds if these are
# missing: the failure is logged and terms_acceptances.email_sent_at stays null.
# Verify the sending domain in Resend, then set a from address on that domain.
RESEND_API_KEY=
EMAIL_FROM=Teleforce <legal@tryteleforce.com>
# Ops BCC on the acceptance email. TERMS_ACCEPTANCE_BCC wins over OPS_EMAIL.
# If both are unset, the portal BCCs legal@tryteleforce.com.
TERMS_ACCEPTANCE_BCC=
OPS_EMAIL=

# Internal alert when a signup account is created. Comma-separated.
# Uses the same Resend API key and EMAIL_FROM as the Terms email.
# If unset, the portal emails rafael@recaldelaw.com.
# A send failure is logged and does not block signup.
SIGNUP_ALERT_TO=

# Client welcome email, sent separately from the Terms copy when an account
# is created. Same Resend API key and EMAIL_FROM. The button links here.
# If unset, the portal uses https://calendly.com/tryteleforce-sales, which is
# also the scheduler on the signed-in home page.
# A send failure is logged and does not block signup.
ONBOARDING_CALENDLY_URL=https://calendly.com/tryteleforce-sales

# Task due dates use a private ICS feed (a secret token in the URL).
# No Google API credentials. Leave GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET unset.
# The portal does not push events through Google OAuth.
