# ── Teleforce client portal (preview / mockup) ─────────────────────────────
# This build is a client-facing PREVIEW with demo data — no Stripe, no real
# billing, no card handling. It runs with zero config; the vars below are
# optional. Copy to .env.local only if you want to override defaults.

# Public base URL of this app (no trailing slash).
# Local: http://localhost:3000  ·  Prod: https://portal.tryteleforce.com
APP_URL=http://localhost:3000

# Signs the session cookie. A built-in demo default is used if unset — set your
# own for anything shared publicly.  Generate: openssl rand -base64 48
AUTH_SECRET=

# Optional passcode to gate the preview (so it isn't wide open when you share the
# link). If set, visitors must enter it on the sign-in screen.
PORTAL_PASSCODE=
