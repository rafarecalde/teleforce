---
import type { FaqStep } from '../consts';

interface Props {
  answer: string;
  steps?: readonly FaqStep[];
  tail?: string;
}

const { answer, steps, tail } = Astro.props;
const list = steps ?? [];
---

<p>{answer}</p>
{
  list.length > 0 && (
    <ul>
      {list.map((step) => (
        <li>
          <b>{step.label}</b> — {step.detail}
        </li>
      ))}
    </ul>
  )
}
{tail && <p class="tail">{tail}</p>}

<style>
  p {
    font-size: 15px;
    color: var(--on-paper-mut);
    margin-top: 14px;
    line-height: 1.6;
  }
  ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--on-paper-mut);
  }
  li::before {
    content: "›";
    position: absolute;
    left: 2px;
    color: var(--amber);
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
  }
  li b {
    font-weight: 600;
    color: var(--on-paper);
  }
  p.tail {
    margin-top: 12px;
  }
</style>
