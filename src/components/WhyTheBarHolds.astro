---
import { STATS, LOGOS } from '../consts';

interface Props {
  id?: string;
}

const { id = 'proof' } = Astro.props;
const marquee = [...LOGOS, ...LOGOS];
---
<section class="block bar-holds" id={id}>
  <div class="wrap reveal">
    <div class="eyebrow">Why the bar holds</div>
    <h2 class="disp">Thirty years of running the operation. Applied to one seat.</h2>
    <p class="sub" style="max-width:64ch">
      Your EA comes with Teleforce behind them — a bilingual LATAM employer for U.S. companies with 30 years of Fortune 500-grade recruiting, training, and QA. You’re not buying a marketplace profile. You’re plugging into a brand that owns the seat: match, onboarding, a partnership manager, and full back-end support for as long as you need the role.
    </p>
    <div class="proof-stats">
      {STATS.map((s) => (
        <div class="pstat">
          <span class="n">{s.n}</span>
          <span class="k">{s.k}</span>
        </div>
      ))}
      <div class="pstat">
        <span class="n">EN / ES</span>
        <span class="k">Native bilingual</span>
      </div>
    </div>
  </div>
  <div class="logos">
    <div class="lab">Trusted by global enterprises for 30+ years</div>
    <div class="marquee-mask">
      <div class="marquee">{marquee.map((n) => <span>{n}</span>)}</div>
    </div>
  </div>
</section>

<style>
  .bar-holds { padding-bottom: 0; }
  .proof-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 32px;
  }
  .pstat {
    background: var(--paper);
    border: 1px solid var(--line-paper);
    border-radius: 14px;
    padding: 18px 16px;
  }
  .pstat .n {
    display: block;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .pstat .k {
    display: block;
    margin-top: 4px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-paper-mut);
  }
  @media (max-width: 700px) {
    .proof-stats { grid-template-columns: 1fr 1fr; }
  }
</style>
