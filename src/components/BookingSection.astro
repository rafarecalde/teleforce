---
// Booking / lead section. When CALENDLY_URL is set, renders the Calendly
// scheduling widget and fires the Google Ads conversion on a completed booking.
// Otherwise falls back to the on-page proposal form.
import ProposalForm from './ProposalForm.astro';
import { CALENDLY_URL, PHONE, PHONE_HREF } from '../consts';

interface Props {
  id?: string; // anchor id CTAs point to
  heading?: string; // shown above the widget / form
  sub?: string; // form sub / widget sub
  subject?: string; // form email subject (fallback only)
  idPrefix?: string; // form field id prefix (fallback only)
}
const {
  id = 'proposal',
  heading = 'Book a call.',
  sub = 'Pick a time and we’ll come prepared with a staffing plan. A human runs every call — no bots, no self-serve.',
  subject = 'New Teleforce proposal request',
  idPrefix = 'p',
} = Astro.props;
---
{CALENDLY_URL ? (
  <section class="contact" id={id}>
    <div class="wrap">
      <div class="eyebrow" style="color:var(--amber)">Book a call</div>
      <h2 class="disp" style="color:#fff">{heading}</h2>
      <p class="sub" style="color:var(--on-dark-mut);max-width:60ch">{sub} Prefer to talk now? Call <a href={PHONE_HREF} style="color:var(--amber);font-weight:600">{PHONE}</a>.</p>
      <div class="calendly-inline-widget" data-url={CALENDLY_URL} style="min-width:320px;height:700px;margin-top:24px"></div>
    </div>
    <script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>
    <script is:inline>
      window.addEventListener('message', function (e) {
        if (e.origin === 'https://calendly.com' && e.data && e.data.event === 'calendly.event_scheduled') {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'conversion', { send_to: 'AW-18332056932/JvJ9COL479McEOT6s6VE' });
          }
        }
      });
    </script>
  </section>
) : (
  <ProposalForm id={id} heading={heading} sub={sub} subject={subject} idPrefix={idPrefix} />
)}
