---
// Booking section. Embeds the Google Calendar appointment scheduler inline
// (name/email/phone are collected in Google's booking form). Google's embed emits
// no completed-booking event, so we count the first "Book a call" CTA click that
// opens this section as the Google Ads conversion signal.
import ProposalForm from './ProposalForm.astro';
import { GOOGLE_EMBED_URL, PHONE, PHONE_HREF } from '../consts';

interface Props {
  id?: string; // anchor id CTAs point to
  /** Second hash that scrolls to the same section (e.g. legacy #match). */
  alias?: string;
  heading?: string;
  sub?: string;
  eyebrow?: string;
  subject?: string; // fallback form only
  idPrefix?: string; // fallback form only
}
const {
  id = 'proposal',
  alias,
  heading = 'Book a call.',
  sub = 'Pick a time and we’ll come prepared. Bookings run a quick discovery call — name, email, and phone are collected when you book.',
  eyebrow = 'Book a call',
  subject = 'New Teleforce proposal request',
  idPrefix = 'p',
} = Astro.props;

const trackHashes = [id, ...(alias ? [alias] : [])];
const ctaSelector = trackHashes.map((hash) => `a[href$="#${hash}"]`).join(', ');

// Fire the Ads conversion once on the first click of a CTA that opens this section.
const convScript = `(function(){var f=false;document.addEventListener('click',function(e){var t=e.target.closest&&e.target.closest(${JSON.stringify(ctaSelector)});if(t&&!f){f=true;if(typeof window.gtag==='function'){window.gtag('event','conversion',{send_to:'AW-18332056932/JvJ9COL479McEOT6s6VE'});}}},true);})();`;
---
{GOOGLE_EMBED_URL ? (
  <section class="contact" id={id}>
    {alias && <span id={alias} class="anchor-alias"></span>}
    <div class="wrap">
      <div class="eyebrow" style="color:var(--amber)">{eyebrow}</div>
      <h2 class="disp" style="color:#fff">{heading}</h2>
      <p class="sub" style="color:var(--on-dark-mut);max-width:60ch">{sub} Prefer to talk now? Call <a href={PHONE_HREF} style="color:var(--amber);font-weight:600">{PHONE}</a>.</p>
      <div class="gcal-embed">
        <iframe src={GOOGLE_EMBED_URL} width="100%" height="680" frameborder="0" style="border:0" title="Book a call with Teleforce" loading="lazy"></iframe>
      </div>
    </div>
    <script is:inline set:html={convScript} />
  </section>
) : (
  <ProposalForm id={id} heading={heading} sub={sub} subject={subject} idPrefix={idPrefix} />
)}

<style>
  .contact{position:relative;scroll-margin-top:72px}
  .anchor-alias{position:absolute;top:0;left:0;width:1px;height:1px;overflow:hidden;scroll-margin-top:72px}
  .gcal-embed{max-width:760px;margin:26px auto 0;border-radius:16px;overflow:hidden;background:#fff;border:1px solid var(--line-dark)}
  .gcal-embed iframe{display:block;width:100%;height:680px}
</style>
