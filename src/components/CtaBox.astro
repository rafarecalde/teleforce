---
// Inline article CTA. Defaults to the standard book-a-call message.
interface Props { heading?: string; body?: string; label?: string; href?: string }
const {
  heading = 'See where nearshore lands for your volumes',
  body = "Teleforce runs bilingual, U.S.-hours support on a Fortune 500 backbone. Tell us your channels and we'll come back with a staffing plan in two business days.",
  label = 'Book a call',
  href = '/#contact',
} = Astro.props;
---
<div class="cta-box">
  <h4>{heading}</h4>
  <p>{body}</p>
  <a href={href} class="btn btn-amber">{label}</a>
</div>
