---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Thanks — we'll be in touch | Teleforce"
  description="Your message reached the Teleforce team. We'll come back about a dedicated executive assistant within two business days."
  noindexFollow
>
  <header class="ahead">
    <div class="wrap">
      <div class="cat">Message sent</div>
      <h1>Thanks — we've got it.</h1>
      <div class="ameta"><span>We reply within two business days</span></div>
    </div>
  </header>

  <article class="post">
    <p class="lead">Your message reached the Teleforce team. We'll come back about a dedicated executive assistant — usually within two business days.</p>
    <p>In the meantime, you can keep reading on <a href="/blog">Signal</a>, or head back to the <a href="/">home page</a>.</p>

    <div class="cta-box">
      <h4>Want to get ahead of the call?</h4>
      <p>Jot down the work you want off your plate — inbox, calendar, follow-ups, vendors — so the first conversation can go straight to the seat.</p>
      <a href="/" class="btn btn-amber">Back to home</a>
    </div>
  </article>
</BaseLayout>
