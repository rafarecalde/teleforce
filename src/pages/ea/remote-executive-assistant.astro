<script>
  const ROLE_LABELS: Record<string, string> = {
    founder: 'Founder / CEO',
    revenue: 'Revenue / Sales',
    agency: 'Agency',
    ops: 'Ops',
  };
  const KEEP = [
    'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_id',
    'gclid', 'gbraid', 'wbraid', 'fbclid', 'msclkid', 'li_fat_id', 'role',
  ];

  const params = new URLSearchParams(window.location.search);
  const noteEl = document.getElementById('role-note');
  const roleGate = document.getElementById('role-gate');
  const roleSelect = document.getElementById('role-select') as HTMLSelectElement | null;
  const matchWrap = document.querySelector('#match .wrap');
  if (matchWrap) {
    const sub = matchWrap.querySelector('.sub');
    const insertAfter = sub ?? matchWrap.lastElementChild;
    if (roleGate) {
      if (insertAfter) insertAfter.insertAdjacentElement('afterend', roleGate);
      else matchWrap.appendChild(roleGate);
    }
    if (noteEl) {
      if (roleGate) roleGate.insertAdjacentElement('afterend', noteEl);
      else if (insertAfter) insertAfter.insertAdjacentElement('afterend', noteEl);
      else matchWrap.appendChild(noteEl);
    }
  }

  const setRole = (id: string) => {
    if (roleSelect && roleSelect.value !== id) roleSelect.value = id;
    const note = document.getElementById('role-note');
    if (note) {
      if (ROLE_LABELS[id]) {
        note.hidden = false;
        note.textContent = `Matching for ${ROLE_LABELS[id]} — mention it on the call.`;
      } else {
        note.hidden = true;
        note.textContent = '';
      }
    }
    const url = new URL(window.location.href);
    if (id && ROLE_LABELS[id]) url.searchParams.set('role', id);
    else url.searchParams.delete('role');
    history.replaceState({}, '', url);
  };

  roleSelect?.addEventListener('change', () => setRole(roleSelect.value));

  const incoming = params.get('role');
  if (incoming && ROLE_LABELS[incoming]) setRole(incoming);

  const extras = KEEP.map((k) => [k, params.get(k)] as const).filter(([, v]) => Boolean(v));
  if (extras.length) {
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
      const href = a.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('tel:') || href.startsWith('mailto:')) return;
      if (/^https?:/i.test(href) && !href.startsWith(window.location.origin)) return;
      try {
        const u = new URL(href, window.location.origin);
        extras.forEach(([k, v]) => {
          if (v && !u.searchParams.has(k)) u.searchParams.set(k, v);
        });
        a.setAttribute('href', `${u.pathname}${u.search}${u.hash}`);
      } catch {
        /* ignore malformed hrefs */
      }
    });
  }
</script>
