---
import termsMarkdown from '../../legal/terms.md?raw';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EA, EA_PAY_LINE, PHONE, PHONE_HREF } from '../../consts';

const termsVersionMatch = termsMarkdown.match(/^\*Effective\s+([^*]+?)\s*\*/m);
const termsVersion = termsVersionMatch?.[1]?.trim() ?? '';
if (!termsVersion) {
  throw new Error('Terms are missing an effective date.');
}

const price3 = EA.price3mo.toLocaleString('en-US');
const price12 = EA.price12mo.toLocaleString('en-US');
const save = (EA.price3mo - EA.price12mo).toLocaleString('en-US');
const payNote =
  'Nothing is charged now. Add a card now, or add one later before kickoff when we follow up. The first month begins at kickoff — when your EA goes live — or up to 10 days after you’ve been matched and accepted your EA, whichever comes first.';
---
<BaseLayout
  title="Complete your signup | Teleforce"
  description="After discovery, accept terms and choose a 3- or 12-month EA plan. A card is optional. Nothing is charged now."
>
  <header class="hero signup-hero">
    <div class="inner">
      <p class="kicker">After your discovery call</p>
      <h1 class="disp">Complete your signup.</h1>
      <p class="lede">
        Discovery is done. Accept the terms, choose a plan, and create your account.
        <b>{EA_PAY_LINE}</b> A card is optional — nothing is charged now. Add one now, or add it later before kickoff when we follow up.
        Next is onboarding — one call, about 60 minutes, with a prep sheet beforehand.
      </p>
      <ol class="path">
        <li class="done">Discovery</li>
        <li class="now" aria-current="step">Signup</li>
        <li>Onboarding</li>
        <li>Get matched</li>
        <li>Kickoff</li>
      </ol>
    </div>
  </header>

  <section class="signup" id="signup">
    <div class="wrap">
      <form id="signup-form" class="stack" novalidate onsubmit="return false">
        <p id="form-error" class="form-error" role="alert" hidden></p>

        <section class="step-card" aria-labelledby="step-terms-title">
          <header class="step-head">
            <span class="step-num">01</span>
            <div>
              <h2 id="step-terms-title">Accept Terms & Conditions</h2>
              <p>Required before you create an account. We’ll email you a copy of the Terms you accept.</p>
            </div>
          </header>
          <label class="agree" for="terms">
            <input id="terms" type="checkbox" name="terms" />
            <span>I agree to the <a href="/terms" target="_blank" rel="noopener">Teleforce Terms & Conditions</a> effective <span id="terms-version">{termsVersion}</span>.</span>
          </label>
          <p class="err" id="terms-err"></p>
          <div class="field">
            <label for="signed-name">Full legal name</label>
            <input id="signed-name" type="text" name="signed-name" autocomplete="name" spellcheck="false" placeholder="Type your full legal name" />
            <p class="esign" id="esign-note">By typing your full legal name, you agree this is your electronic signature and that it has the same effect as a handwritten signature under the U.S. ESIGN Act and the Uniform Electronic Transactions Act (UETA).</p>
            <p class="err" id="signed-name-err"></p>
          </div>
        </section>

        <section class="step-card" aria-labelledby="step-plan-title">
          <header class="step-head">
            <span class="step-num">02</span>
            <div>
              <h2 id="step-plan-title">Choose your plan</h2>
              <p>Pick a 3-month or 12-month commitment. Nothing is charged now. A card is optional.</p>
            </div>
          </header>

          <fieldset>
            <legend>Choose a plan</legend>
            <div class="plans">
              <label class="plan">
                <input type="radio" name="plan" value="3" checked data-label="3-month" data-price={`$${price3}/mo`} />
                <span class="plan-top">
                  <span class="plan-tag">3-month</span>
                  <span class="radio" aria-hidden="true"></span>
                </span>
                <span class="plan-price"><span class="cur">$</span>{price3}<span class="per">/mo</span></span>
                <span class="plan-sub">3-month commitment · stay flexible</span>
              </label>
              <label class="plan">
                <input type="radio" name="plan" value="12" data-label="12-month" data-price={`$${price12}/mo`} />
                <span class="plan-top">
                  <span class="plan-tag">12-month</span>
                  <span class="radio" aria-hidden="true"></span>
                </span>
                <span class="plan-price"><span class="cur">$</span>{price12}<span class="per">/mo</span></span>
                <span class="plan-sub">Save ${save}/mo on a 12-month commitment</span>
              </label>
            </div>
            <p class="plan-switch">Start on the 3-month plan. Switch to 12 when you’re ready and save ${save}/mo. You can switch as soon as you’re ready, including in month one.</p>
          </fieldset>

          <div class="pay-lock">
            <p>{payNote}</p>
          </div>

          <fieldset class="pay-choice">
            <legend>Payment method</legend>
            <label class="choice">
              <input type="radio" name="card-choice" value="later" checked />
              <span>
                <strong>Add a card later</strong>
                <span class="choice-sub">No charge now. Add a card in the portal before kickoff when we follow up.</span>
              </span>
            </label>
            <label class="choice">
              <input type="radio" name="card-choice" value="now" />
              <span>
                <strong>Add a card now</strong>
                <span class="choice-sub">Saved with Stripe. Nothing is charged today.</span>
              </span>
            </label>
          </fieldset>

          <div id="card-fields" hidden>
            <p class="fine-print" id="pay-note">
              Card details are entered in Stripe’s secure field and are not stored on this site. Nothing is charged today.
            </p>

            <div class="field">
              <label for="card-name">Name on card</label>
              <input id="card-name" type="text" inputmode="text" autocomplete="cc-name" spellcheck="false" placeholder="Name on card" aria-describedby="pay-note" />
              <p class="err" id="card-name-err"></p>
            </div>

            <div class="field">
              <label for="card-element">Card</label>
              <div id="card-element" class="card-mount" role="group" aria-label="Card number, expiry, CVC, and ZIP" aria-describedby="pay-note card-status"></div>
              <p class="fine-print" id="card-status">Loading secure card field…</p>
              <p class="err" id="card-element-err"></p>
            </div>
          </div>
        </section>

        <section class="step-card" aria-labelledby="step-account-title">
          <header class="step-head">
            <span class="step-num">03</span>
            <div>
              <h2 id="step-account-title">Create your account</h2>
              <p>This is how you’ll sign back in. It does not start billing.</p>
            </div>
          </header>

          <div class="field">
            <label for="full-name">Full name</label>
            <input id="full-name" type="text" autocomplete="name" placeholder="Full name" />
            <p class="err" id="full-name-err"></p>
          </div>
          <div class="field">
            <label for="email">Work email</label>
            <input id="email" type="email" autocomplete="email" inputmode="email" placeholder="you@company.com" />
            <p class="err" id="email-err"></p>
          </div>
          <div class="split">
            <div class="field">
              <label for="password">Password</label>
              <input id="password" type="password" autocomplete="new-password" placeholder="At least 8 characters" />
              <p class="err" id="password-err"></p>
            </div>
            <div class="field">
              <label for="password-2">Confirm password</label>
              <input id="password-2" type="password" autocomplete="new-password" placeholder="Repeat password" />
              <p class="err" id="password-2-err"></p>
            </div>
          </div>

          <button type="button" class="btn btn-amber submit" id="signup-submit">Complete signup</button>
        </section>
      </form>

      <section id="signup-done" class="step-card done-card" hidden>
        <p class="step-kicker">Signup complete</p>
        <h2 class="disp">You’re set for onboarding.</h2>
        <p class="done-lead">
          Next is your onboarding call — about 60 minutes. You’ll get a prep sheet beforehand.
          There’s no booking calendar on this page. Sign in to the client portal with the email and password you just chose.
        </p>
        <p class="done-plan" id="done-plan"></p>
        <p class="support" id="done-account"></p>
        <ol class="path path-paper">
          <li class="done">Discovery</li>
          <li class="done">Signup</li>
          <li class="now">Onboarding</li>
          <li>Get matched</li>
          <li>Kickoff</li>
        </ol>
        <div class="pay-lock">
          <p>{payNote}</p>
        </div>
        <p class="support">
          After the onboarding call, your partnership manager owns matching. Once your EA is live, you run the day-to-day together, with full back-end support behind the seat.
        </p>
        <div class="done-actions">
          <a class="btn btn-amber" id="portal-link" href="https://portal.tryteleforce.com">Sign in to your account</a>
          <a class="btn btn-quiet" href="/">Home</a>
        </div>
      </section>

      <p class="help">
        Questions before you finish? Call <a href={PHONE_HREF}>{PHONE}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const portalUrl = (
    import.meta.env.PUBLIC_PORTAL_URL ||
    (import.meta.env.DEV ? 'http://localhost:3000' : 'https://portal.tryteleforce.com')
  ).replace(/\/$/, '');

  const form = document.getElementById('signup-form');
  const done = document.getElementById('signup-done');
  const formError = document.getElementById('form-error');
  const cardStatus = document.getElementById('card-status');
  const portalLink = document.getElementById('portal-link');
  if (portalLink instanceof HTMLAnchorElement) portalLink.href = portalUrl;

  const fields = {
    terms: document.getElementById('terms'),
    signedName: document.getElementById('signed-name'),
    cardName: document.getElementById('card-name'),
    fullName: document.getElementById('full-name'),
    email: document.getElementById('email'),
    password: document.getElementById('password'),
    password2: document.getElementById('password-2'),
  };

  let termsVersion = document.getElementById('terms-version')?.textContent?.trim() || '';
  let termsReady = false;
  let signedDirty = false;
  let signedConfirmed = false;

  const submitButton = document.getElementById('signup-submit');
  if (submitButton instanceof HTMLButtonElement) {
    submitButton.disabled = true;
    submitButton.textContent = 'Loading terms…';
  }

  function currentSignedName() {
    if (!(fields.signedName instanceof HTMLInputElement)) return '';
    return fields.signedName.value.trim().replace(/\s+/g, ' ');
  }

  fields.fullName?.addEventListener('input', () => {
    if (signedDirty) return;
    if (!(fields.fullName instanceof HTMLInputElement)) return;
    if (!(fields.signedName instanceof HTMLInputElement)) return;
    fields.signedName.value = fields.fullName.value;
    signedConfirmed = false;
  });

  fields.signedName?.addEventListener('input', () => {
    signedDirty = true;
    signedConfirmed = true;
  });

  fields.signedName?.addEventListener('blur', () => {
    if (currentSignedName().length >= 2) signedConfirmed = true;
  });

  async function loadTermsVersion() {
    try {
      const res = await fetch(`${portalUrl}/api/signup/terms`, { credentials: 'omit' });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.termsVersion) return;
      const next = String(data.termsVersion).trim();
      if (!next || next === termsVersion) {
        termsVersion = next || termsVersion;
        return;
      }
      const node = document.getElementById('terms-version');
      if (node) node.textContent = next;
      termsVersion = next;
      if (fields.terms instanceof HTMLInputElement && fields.terms.checked) {
        fields.terms.checked = false;
        setErr('terms', 'The Terms version changed. Review them and agree again.');
      }
    } catch {
      // Keep the version rendered with this page. The server rejects a mismatch.
    } finally {
      termsReady = true;
      if (submitButton instanceof HTMLButtonElement && !running) {
        submitButton.disabled = false;
        submitButton.textContent = 'Complete signup';
      }
    }
  }

  /** @type {any} */
  let stripe = null;
  /** @type {any} */
  let card = null;
  let cardComplete = false;
  let cardEmpty = true;
  let cardReady = false;
  let cardInitStarted = false;

  function wantsCard() {
    const selected = form?.querySelector('input[name="card-choice"]:checked');
    return selected instanceof HTMLInputElement && selected.value === 'now';
  }

  function syncCardFields() {
    const box = document.getElementById('card-fields');
    if (box) box.hidden = !wantsCard();
  }

  syncCardFields();
  form?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement) || target.name !== 'card-choice') return;
    syncCardFields();
    if (wantsCard()) initCard();
  });

  function setErr(id, message) {
    const err = document.getElementById(`${id}-err`);
    const input = document.getElementById(id);
    if (err) err.textContent = message;
    if (input) input.setAttribute('aria-invalid', message ? 'true' : 'false');
    return !message;
  }

  function clearErrors() {
    document.querySelectorAll('.err').forEach((el) => {
      el.textContent = '';
    });
    document.querySelectorAll('[aria-invalid="true"]').forEach((el) => {
      el.setAttribute('aria-invalid', 'false');
    });
    if (formError) {
      formError.hidden = true;
      formError.textContent = '';
    }
  }

  function showFormError(message) {
    if (!formError) return;
    formError.hidden = false;
    formError.textContent = message;
  }

  function loadStripeJs() {
    const host = /** @type {any} */ (window);
    if (typeof host.Stripe === 'function') return Promise.resolve();
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://js.stripe.com/v3/';
      script.async = true;
      script.onload = () => resolve(undefined);
      script.onerror = () => reject(new Error('Could not load the secure card field.'));
      document.head.appendChild(script);
    });
  }

  async function initCard() {
    if (cardInitStarted || cardReady) return;
    cardInitStarted = true;
    try {
      const res = await fetch(`${portalUrl}/api/signup/config`, { credentials: 'omit' });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Card form is unavailable.');
      await loadStripeJs();
      const StripeCtor = /** @type {any} */ (window).Stripe;
      if (typeof StripeCtor !== 'function') throw new Error('Could not load the secure card field.');
      stripe = StripeCtor(data.publishableKey);
      card = stripe.elements().create('card', {
        hidePostalCode: false,
        style: {
          base: {
            fontFamily: 'Inter, sans-serif',
            fontSize: '16px',
            color: '#17302e',
            '::placeholder': { color: '#8b9aa0' },
          },
          invalid: { color: '#8c3a2f' },
        },
      });
      card.mount('#card-element');
      card.on('change', (event) => {
        cardComplete = !!event.complete;
        cardEmpty = !!event.empty;
        setErr('card-element', event.error ? event.error.message : '');
      });
      card.on('ready', () => {
        cardReady = true;
        if (cardStatus) cardStatus.textContent = 'Secured by Stripe. Nothing is charged today.';
      });
    } catch (err) {
      cardInitStarted = false;
      if (cardStatus) {
        cardStatus.textContent = err instanceof Error ? err.message : 'Card form is unavailable.';
      }
    }
  }

  async function postJson(path, body) {
    let res;
    try {
      res = await fetch(`${portalUrl}${path}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'omit',
        body: JSON.stringify(body),
      });
    } catch {
      throw new Error('Could not reach the client portal. Try again in a moment.');
    }
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Signup could not be completed.');
    return data;
  }

  let running = false;

  loadTermsVersion();

  async function finish(event) {
    event?.preventDefault();
    if (running || !termsReady) return;
    running = true;
    clearErrors();

    let firstBad = null;
    const mark = (id, message) => {
      const ok = setErr(id, message);
      if (!ok && !firstBad) firstBad = document.getElementById(id);
      return ok;
    };

    const termsOk = fields.terms instanceof HTMLInputElement && fields.terms.checked;
    mark('terms', termsOk ? '' : 'Agree to the Terms & Conditions to continue.');

    const signed = currentSignedName();
    let signedError = '';
    if (signed.length < 2) signedError = 'Type your full legal name to sign the Terms.';
    else if (!signed.includes(' ')) signedError = 'Type your full legal name to sign the Terms.';
    else if (!signedDirty && !signedConfirmed) signedError = 'Confirm your full legal name in the signature field.';
    mark('signed-name', signedError);

    const addingCard = wantsCard();
    const cardName = fields.cardName instanceof HTMLInputElement ? fields.cardName.value.trim() : '';
    if (addingCard) {
      mark('card-name', cardName.length >= 2 ? '' : 'Enter the name on the card.');
      if (!cardReady || !card) {
        mark('card-element', 'The secure card field isn’t ready yet. You can add a card later instead.');
      } else if (!cardComplete || cardEmpty) {
        mark('card-element', 'Enter the card number, expiry, CVC, and ZIP.');
      } else {
        mark('card-element', '');
      }
    } else {
      mark('card-name', '');
      mark('card-element', '');
    }

    const name = fields.fullName instanceof HTMLInputElement ? fields.fullName.value.trim() : '';
    mark('full-name', name.length >= 2 ? '' : 'Enter your name.');

    const email = fields.email instanceof HTMLInputElement ? fields.email.value.trim() : '';
    mark('email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? '' : 'Enter a work email.');

    const password = fields.password instanceof HTMLInputElement ? fields.password.value : '';
    const passwordBytes = new TextEncoder().encode(password).length;
    mark('password', password.length >= 8 && passwordBytes <= 72 ? '' : 'Use 8 to 72 characters.');

    const password2 = fields.password2 instanceof HTMLInputElement ? fields.password2.value : '';
    mark(
      'password-2',
      password2.length === 0 ? 'Confirm your password.' : password2 === password ? '' : 'Passwords don’t match.',
    );

    const submit = document.getElementById('signup-submit');
    if (firstBad || !form) {
      showFormError('Check the highlighted fields.');
      if (firstBad instanceof HTMLElement) firstBad.focus();
      running = false;
      return;
    }

    const selected = form.querySelector('input[name="plan"]:checked');
    const plan = selected instanceof HTMLInputElement ? selected.value : '3';
    const planLabel = selected instanceof HTMLInputElement ? selected.dataset.label : '3-month';
    const planPrice = selected instanceof HTMLInputElement ? selected.dataset.price : '';

    if (submit instanceof HTMLButtonElement) {
      submit.disabled = true;
      submit.textContent = addingCard ? 'Saving card…' : 'Creating account…';
    }

    try {
      /** @type {Record<string, unknown>} */
      const account = {
        email,
        fullName: name,
        password,
        plan,
        termsAccepted: true,
        signedName: signed,
        termsVersion,
      };

      if (addingCard) {
        const setup = await postJson('/api/signup/setup-intent', {
          email,
          fullName: name,
          plan,
        });
        const confirmed = await stripe.confirmCardSetup(setup.clientSecret, {
          payment_method: {
            card,
            billing_details: { name: cardName, email },
          },
        });
        if (confirmed.error) {
          throw new Error(confirmed.error.message || 'The card was not saved.');
        }
        account.setupIntentId = confirmed.setupIntent && confirmed.setupIntent.id;
        account.nonce = setup.nonce;
        if (submit instanceof HTMLButtonElement) submit.textContent = 'Creating account…';
      }

      await postJson('/api/signup/complete', account);

      const planLine = document.getElementById('done-plan');
      if (planLine) planLine.textContent = `${planLabel} plan · ${planPrice}`;
      const accountLine = document.getElementById('done-account');
      if (accountLine) {
        accountLine.textContent = addingCard
          ? `Account created for ${email}. Your card is on file. Nothing was charged.`
          : `Account created for ${email}. No card on file yet. Nothing was charged. Add a payment method before kickoff — we’ll follow up.`;
      }

      ['card-name', 'password', 'password-2'].forEach((id) => {
        const input = document.getElementById(id);
        if (input instanceof HTMLInputElement) input.value = '';
      });
      if (card) card.clear();

      form.hidden = true;
      if (done) {
        done.hidden = false;
        done.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    } catch (err) {
      showFormError(err instanceof Error ? err.message : 'Signup could not be completed.');
      running = false;
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = false;
        submit.textContent = 'Complete signup';
      }
    }
  }

  // Keep this off a native submit. The site tag treats submit as a conversion
  // and can forward field values. Card data stays in the Stripe iframe.
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    event.stopImmediatePropagation();
    finish(event);
  }, true);

  document.getElementById('signup-submit')?.addEventListener('click', finish);

  form?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    if (!(event.target instanceof HTMLInputElement)) return;
    if (event.target.type === 'checkbox' || event.target.type === 'radio') return;
    event.preventDefault();
    finish(event);
  });
</script>

<style>
  .signup-hero { padding: 52px 0 40px; }
  .signup-hero h1.disp {
    font-size: clamp(36px, 6vw, 58px);
    text-transform: none;
    line-height: 1.02;
    max-width: 14ch;
    margin: 0;
  }
  .signup-hero .lede { margin-top: 18px; }
  .path {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
  }
  .path li {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-mut);
  }
  .path li:not(:last-child)::after {
    content: "→";
    margin: 0 10px;
    color: var(--sage);
  }
  .path li.done { color: var(--sage); }
  .path li.now { color: var(--amber); }

  .signup { background: var(--paper-2); padding: 28px 0 72px; }
  .stack { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
  .step-card {
    background: var(--paper);
    border: 1px solid var(--line-paper);
    border-radius: 18px;
    padding: 26px 26px 28px;
  }
  .step-head { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 18px; }
  .step-head h2 {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 4px;
  }
  .step-head p, .support, .done-lead { font-size: 14.5px; color: var(--on-paper-mut); line-height: 1.55; }
  .step-num, .step-kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--amber);
    padding-top: 4px;
  }
  .step-kicker { display: block; margin-bottom: 10px; text-transform: uppercase; padding-top: 0; }

  .agree {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15.5px;
    line-height: 1.45;
    cursor: pointer;
  }
  .agree input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--amber);
    flex-shrink: 0;
  }
  .agree a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--sage);
    text-underline-offset: 3px;
  }
  .agree a:hover { text-decoration-color: var(--amber); }
  .esign {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--on-paper-mut);
  }

  fieldset { border: 0; margin: 0; padding: 0; min-inline-size: 0; }
  legend {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sage-deep);
