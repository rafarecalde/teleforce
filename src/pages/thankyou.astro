---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="You're booked — thank you | Teleforce"
  description="Your call with the Teleforce team is booked. We'll come ready to talk about a dedicated executive assistant."
  noindexFollow
>
  <!-- Google Ads conversion — fires on this page load. Set Calendly to redirect
       here after a booking, so a completed booking is measured as a conversion. -->
  <script slot="head" is:inline>
    gtag('event', 'conversion', {'send_to': 'AW-18332056932/JvJ9COL479McEOT6s6VE'});
  </script>
  <header class="ahead">
    <div class="wrap">
      <div class="cat">You're booked</div>
      <h1>Thank you — your call is set.</h1>
      <div class="ameta"><span>Check your email for the calendar invite</span></div>
    </div>
  </header>

  <article class="post">
    <p class="lead">Your call with the Teleforce team is booked. You'll get a calendar invite by email — and we'll come ready to talk about a dedicated EA: a 30-minute onboarding, a match in about a week, and kickoff in about two weeks.</p>
    <p>While you wait, you can keep reading on <a href="/blog">Signal</a>, or head back to the <a href="/">home page</a>.</p>

    <div class="cta-box">
      <h4>Want to make the call faster?</h4>
      <p>Have the work you want off your plate handy — inbox, calendar, follow-ups, vendors. That's enough to see if we have your fit.</p>
      <a href="/" class="btn btn-amber">Back to home</a>
    </div>
  </article>
</BaseLayout>
