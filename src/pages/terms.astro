---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content } from '../legal/terms.md';
---
<BaseLayout
  title="Terms & Conditions | Teleforce"
  description="Teleforce Terms of Service for executive assistant services. Covers signup, when billing starts, matching, rematch, and 3-month or 12-month plans."
>
  <header class="ahead">
    <div class="wrap">
      <div class="crumb"><a href="/">Home</a> · <a href="/ea/signup">Signup</a></div>
      <div class="cat">Legal</div>
      <h1>Terms & Conditions</h1>
    </div>
  </header>

  <article class="post">
    <p class="lead">Teleforce Terms of Service</p>
    <Content />
  </article>
</BaseLayout>

<style>
  /* Marketing headlines cap at 18ch. This title should sit on one line. */
  .ahead h1 {
    max-width: none;
  }
</style>
