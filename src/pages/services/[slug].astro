---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBox from '../../components/CtaBox.astro';
import { SERVICES } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const content = await getCollection('services');
  return SERVICES.map((svc) => ({
    params: { slug: svc.slug },
    props: { svc, entry: content.find((c) => c.id === `${svc.slug}.md` || c.slug === svc.slug) },
  }));
}

const { svc, entry } = Astro.props;
const Content = entry ? (await entry.render()).Content : null;
const faq = entry?.data.faq ?? [];

// Swappable photo slot: image2..image7 by service order (image1 = homepage band).
const imgIndex = SERVICES.findIndex((s) => s.slug === svc.slug) + 2;
const featureImg = `/brand/image${imgIndex}.jpg`;
const posts = await getPublishedPosts();
const related = posts.filter((p) => p.data.category === svc.category).slice(0, 4);

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${svc.name} — Teleforce`,
  serviceType: svc.name,
  description: svc.intro,
  provider: { '@type': 'Organization', name: 'Teleforce' },
  areaServed: ['US', 'CA'],
};
const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
const jsonLd = faqLd ? [serviceLd, faqLd] : serviceLd;
---
<BaseLayout
  title={`${svc.name} Outsourcing | Teleforce`}
  description={svc.intro.slice(0, 155)}
  jsonLd={jsonLd}
>
  <header class="ahead">
    <div class="wrap">
      <div class="crumb"><a href="/services">Services</a> / {svc.name}</div>
      <div class="cat">{svc.navLabel}</div>
      <h1>{svc.tagline}</h1>
      <div class="ameta"><span>Bilingual EN / ES</span><span>LATAM · U.S. hours</span><span>Fortune 500-grade backbone</span></div>
    </div>
  </header>

  <div class="wrap" style="margin-top:24px">
    <img class="feature-img" src={featureImg} alt={`Teleforce ${svc.name}`} loading="lazy" />
  </div>

  <article class="post">
    <p class="lead">{svc.intro}</p>

    <h2>What's included</h2>
    <ul class="svc-list">
      {svc.included.map((item) => <li>{item}</li>)}
    </ul>

    {Content ? (
      <Content />
    ) : (
      <>
        <h2>Why run it with Teleforce</h2>
        <p>Teleforce delivers from across Latin America — clear, accent-neutral Spanish, full U.S. business-hours overlap, and higher agent retention than offshore alternatives. You get bilingual English/Spanish coverage from one team, on your hours, working as an extension of your brand. And because Teleforce runs on a Fortune 500-grade support backbone — 30+ years across 20+ industries — the recruiting, training, QA, and security are already in place.</p>
      </>
    )}

    {faq.length > 0 && (
      <section>
        <div class="rule"></div>
        <h2>Frequently asked questions</h2>
        {faq.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))}
      </section>
    )}

    <h2>How to engage</h2>
    <p>Two ways to work with us: <strong>flat-fee recruitment</strong> — we source and vet the agents, you interview, hire, and manage them (with a 60–90 day replacement guarantee) — or a <strong>managed FTE seat</strong>, where we run the whole operation. Pricing is quote-based and depends on role, skill, and volume. <a href="/#pricing">See how it works →</a> or <a href="/#contact">contact us for a quote →</a></p>

    <CtaBox
      heading={`Let's scope your ${svc.name.toLowerCase()} team`}
      body="Tell us your channels, languages, and rough monthly volume. We'll come back with a staffing plan and a go-live date — usually within two business days."
      label="Book a call"
    />
  </article>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap">
        <div class="lab">From Signal · {svc.navLabel}</div>
        <div class="rgrid">
          {related.map((r) => (
            <a href={`/blog/${r.slug}`} class="rcard">
              <div class="tagcat">{r.data.category}</div>
              <h3>{r.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="block">
    <div class="wrap">
      <div class="gridhead">All services</div>
      <div class="offer svcs">
        {SERVICES.map((s) => (
          <a href={`/services/${s.slug}`} class="cell link">
            <div class="ic">{s.ic}</div>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="more">Learn more <span class="ar">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
