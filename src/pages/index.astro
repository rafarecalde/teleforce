---
import BaseLayout from '../layouts/BaseLayout.astro';
import Waveform from '../components/Waveform.astro';
import { SITE, STATS, LOGOS, SERVICES, MODELS, TESTIMONIALS, PHONE, PHONE_HREF, FORM_ACTION } from '../consts';

// Duplicate the logo list so the marquee scrolls seamlessly (-50% loop).
const marquee = [...LOGOS, ...LOGOS];
---
<BaseLayout title="Teleforce — Bilingual Customer Support" description={SITE.description}>

  <header class="hero" id="top">
    <Waveform variant="hero" />
    <div class="inner">
      <div class="kicker">Customer support, done for you</div>
      <h1 class="disp">
        Answered.<br />
        <span class="l2">In both languages.</span><br />
        <span class="l3">On your clock.</span>
      </h1>
      <p class="lede">Teleforce is a <b>bilingual LATAM BPO</b> for U.S. companies — customer service, tech support, collections, and the back-office work behind them.
        Dedicated English/Spanish agents who work as an extension of your brand, on U.S. time.
        Built on <b>a Fortune 500-grade support backbone</b>, 30+ years deep — so there's no startup ramp to wait through.</p>
      <div class="hero-cta">
        <a href="#contact" class="btn btn-amber">Book a call</a>
        <a href="#pricing" class="btn btn-ghost">See pricing</a>
      </div>
    </div>
  </header>

  <div class="trust">
    <div class="row">
      {STATS.map((s) => (
        <div class="stat"><span class="n">{s.n}</span><span class="k">{s.k}</span></div>
      ))}
    </div>
  </div>

  <div class="logos">
    <div class="lab">Trusted by global enterprises for 30+ years</div>
    <div class="marquee-mask">
      <div class="marquee">
        {marquee.map((name) => <span>{name}</span>)}
      </div>
    </div>
  </div>

  <section class="block" id="services">
    <div class="wrap reveal">
      <div class="eyebrow">What we do</div>
      <h2 class="disp">One bilingual team, six ways to deploy it.</h2>
      <p class="sub">Teleforce is a bilingual nearshore BPO. Customer service is where most clients start — then they add the back-office and revenue functions behind it, from the same trained team, on U.S. hours.</p>
      <div class="offer svcs">
        {SERVICES.map((s) => (
          <a href={`/services/${s.slug}`} class="cell link">
            <div class="ic">{s.ic}</div>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="more">Learn more <span class="ar">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="howwrap">
    <section class="block" id="how">
      <div class="wrap reveal">
        <div class="eyebrow">How it works</div>
        <h2 class="disp">Live in about 30 days.</h2>
        <div class="steps">
          <div class="step"><div class="num">01</div><h4>Scope</h4><p>We map your volumes, channels, tools, and the voice your customers expect.</p></div>
          <div class="step"><div class="num">02</div><h4>Staff &amp; train</h4><p>We select bilingual agents and train them on your product as brand staff.</p></div>
          <div class="step"><div class="num">03</div><h4>Go live</h4><p>Your team starts taking contacts — with QA, reporting, and a named lead from day one.</p></div>
        </div>
      </div>
    </section>
  </div>

  <section class="block" id="why">
    <div class="wrap reveal">
      <div class="eyebrow">Why Teleforce</div>
      <h2 class="disp">An established partner, from day one.</h2>
      <div class="why">
        <div class="item"><div class="b">›</div><div><h4>No ramp risk</h4><p>Most nearshore vendors build their org while they build your team. Ours is already decades deep.</p></div></div>
        <div class="item"><div class="b">›</div><div><h4>One seat, two languages</h4><p>Bilingual native agents serve your English and Spanish customers without doubling headcount.</p></div></div>
        <div class="item"><div class="b">›</div><div><h4>U.S. legal &amp; compliance oversight</h4><p>Data handling and consumer-contact compliance supervised by U.S. counsel — rare in this category.</p></div></div>
        <div class="item"><div class="b">›</div><div><h4>A time zone that works</h4><p>Daytime in the U.S. is daytime for your team. No overnight handoffs, lower attrition than offshore.</p></div></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap reveal">
      <div class="eyebrow">In their words</div>
      <h2 class="disp">Results clients talk about.</h2>
      <div class="quotes">
        {TESTIMONIALS.map((t) => (
          <blockquote class="quote">
            <p>“{t.quote}”</p>
            <div class="by"><b>{t.name}</b> · {t.company}</div>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <div class="pricewrap">
    <section class="block" id="pricing">
      <div class="wrap reveal">
        <div class="eyebrow">How to engage</div>
        <h2 class="disp">Two ways to work with us.</h2>
        <p class="sub">Hire the talent and run it yourself, or hand us the whole operation. Either way you get vetted, bilingual LATAM agents on U.S. hours.</p>
        <div class="tiers" style="grid-template-columns:repeat(2,1fr)">
          {MODELS.map((m) => (
            <div class={`tier${m.feature ? ' feature' : ''}`}>
              <div class="tag">{m.tag}</div>
              <div class="price" style="font-size:26px">{m.name}</div>
              <p style="font-size:13.5px;margin:10px 0 14px;opacity:0.9">{m.blurb}</p>
              <ul class="svc-list" style="grid-template-columns:1fr;gap:7px">
                {m.includes.map((i) => <li style="font-size:13.5px">{i}</li>)}
              </ul>
              <div class="desc">{m.note}</div>
              {m.feature && <div class="best">★ Most popular</div>}
            </div>
          ))}
        </div>
        <p class="pricenote">Pricing is quote-based and depends on role, skill, and volume — <a href="#contact" style="color:var(--amber)">contact us for a quote</a>. First-party billing &amp; collections supports flexible pricing (by hire, by seat, or per program).</p>
      </div>
    </section>
  </div>

  <section class="contact" id="contact">
    <div class="wrap reveal">
      <div class="grid">
        <div>
          <div class="eyebrow" style="color:var(--amber)">Book a call</div>
          <h2 class="disp">Let's scope your team.</h2>
          <p class="sub">Tell us your channels and volumes. We'll come back with a staffing plan and a go-live date — usually within two business days.</p>
          <p class="sub" style="margin-top:18px">Prefer to talk? Call <a href={PHONE_HREF} style="color:var(--amber);font-weight:600">{PHONE}</a>.</p>
        </div>
        <form method="POST" action={FORM_ACTION}>
          <input type="hidden" name="_subject" value="New Teleforce inquiry — book a call" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={`${SITE.url}/thanks`} />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="field"><label for="name">Name</label><input id="name" name="name" type="text" placeholder="Your name" required /></div>
          <div class="field"><label for="email">Work email</label><input id="email" name="email" type="email" placeholder="you@company.com" required /></div>
          <div class="field"><label for="need">What do you need?</label><textarea id="need" name="message" rows="3" placeholder="Channels, languages, rough monthly volume…"></textarea></div>
          <button class="btn btn-amber" type="submit">Send &amp; book a call</button>
        </form>
      </div>
    </div>
  </section>

</BaseLayout>
