---
import BaseLayout from '../layouts/BaseLayout.astro';
import Waveform from '../components/Waveform.astro';
import CtaBox from '../components/CtaBox.astro';
import { SITE, STATS, LOGOS, EA, TESTIMONIALS, EA_JOURNEY_FAQ, EA_CLOCK_NOTE, EA_START_FAQ } from '../consts';
import BookingSection from '../components/BookingSection.astro';

const marquee = [...LOGOS, ...LOGOS];
const price12 = EA.price12mo.toLocaleString('en-US');
const price3 = EA.price3mo.toLocaleString('en-US');
const proof = TESTIMONIALS[0];

const STAT_SUB: Record<string, string> = {
  '30+': 'Operating history behind every EA seat',
  '20+': 'Regulated and consumer verticals',
  'Fortune 500': 'Enterprise-grade delivery standards',
};

const falseSolutions = [
  {
    h: 'Cheap / overnight VA',
    p: 'You buy hours. You still own the outcome. And your afternoon is their tomorrow.',
  },
  {
    h: 'AI / chatbots',
    p: 'Drafts are cheap. A human on your clock owns the follow-through — calendar, chase-downs, judgment.',
  },
  {
    h: 'U.S.-only prestige',
    p: 'Real talent. Blown budget. Nearshore economics without the overnight lag.',
  },
  {
    h: 'DIY / marketplace',
    p: 'You become the recruiter, the manager, and the QA. That’s a second job.',
  },
];

const delegate = [
  {
    h: 'Exec day-to-day',
    p: 'The work that eats the week before noon.',
    items: [
      'Inbox triage and drafts in your voice',
      'Calendar, priorities, prep, and briefings',
      'Meeting recaps and the follow-ups that slip',
      'Business travel, expenses, and itineraries',
      'Docs, files, and the system so nothing lives in your head',
    ],
  },
  {
    h: 'Business operations',
    p: 'Pipeline, projects, vendors — owned, not ticketed.',
    items: [
      'CRM updates and pipeline tracking',
      'Vendor coordination and chase-downs',
      'Project tracking — who owes what, by when',
      'Hiring support: sourcing, screening, scheduling',
      'Bilingual EN/ES with U.S. and LatAm counterparts',
    ],
  },
];

const steps = [
  ['Match', 'We match on how you think, communicate, and operate. You interview and select. Most clients are matched in about a week.'],
  ['Onboard', 'Client-specific onboarding — tools, preferences, live work. About 2–5 hours of your time. Then a partnership manager hands the seat off.'],
  ['You run your EA', 'After handoff, it’s your EA. You own the day-to-day relationship. We rematch if the fit isn’t right — we don’t babysit the seat.'],
];

const featuredPortrait = {
  img: '/brand/customers/operator.jpg',
  alt: 'A U.S. operator this seat is built for — head and shoulders, not a face crop',
};

const pillars = [
  {
    h: 'Dedicated seat',
    p: 'One named, full-time bilingual EA on your U.S. hours. Not a pool. Not an hour pack.',
  },
  {
    h: 'Handoff, then yours',
    p: 'We match and onboard. A partnership manager hands the seat off. You run the relationship.',
  },
  {
    h: 'The seat compounds',
    p: 'They learn how you operate. Wrong fit? We rematch. We don’t babysit the chair.',
  },
];

const faq = [
  ...EA_JOURNEY_FAQ,
  {
    q: 'How is my EA selected?',
    a: 'On how you think, communicate, and operate — not a skills-and-resume lottery. The Executive Profile sets that bar. You interview the match and make the final selection. Most clients are matched in one week.',
  },
  {
    q: 'Who runs my EA day to day?',
    a: 'You and your EA do. We set the runway — match, onboard, and hand off. A partnership manager is there for the launch and for rematch — not to run the work forever. After the official start date, you and your EA run the work.',
  },
  { q: 'How long until we’re live?', a: EA_START_FAQ.a },
  {
    q: 'What are the contract lengths?',
    a: `3-month ($${price3}/mo) or 12-month ($${price12}/mo). Start on 3. Switch to 12 when you’re sure and save $300/mo. ${EA_CLOCK_NOTE}`,
  },
  {
    q: 'What does a Teleforce EA actually own?',
    a: 'Business operations: inbox and calendar, follow-ups and chase-downs, priorities and prep, project coordination, travel and vendors, research, docs and systems. Dedicated business leverage — one named seat.',
  },
  {
    q: 'Is this a VA hour pack or a task marketplace?',
    a: 'No. Dedicated business leverage — one full-time bilingual EA on your U.S. hours. Not flexible hour packs. Not a task marketplace. Not overnight gig help. If you want tickets and overflow, this isn’t the seat.',
  },
  {
    q: 'Are they full-time and dedicated to me?',
    a: 'Yes. One named, full-time executive assistant — bilingual English/Spanish, on your U.S. hours. Not a shared pool. After onboarding, you own the relationship.',
  },
  {
    q: 'What if the fit isn’t right?',
    a: 'We rematch. You’re not stuck recruiting from scratch, and you’re not restarting payroll. The 90-day clock and first-month prepaid terms stay as written in the journey answers above.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>

  <header class="hero" id="top">
    <Waveform variant="hero" />
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="kicker">Dedicated EA · LatAm nearshore · U.S. hours</div>
        <h1 class="disp">
          You don’t need more tools.<br />
            <span class="l2">Get an executive assistant.</span>
        </h1>
        <p class="lede">
          Teleforce matches you with a dedicated bilingual EA on U.S. hours — onboarded to how you think and operate, then handed to you. We set the runway. You and your EA run the work.
        </p>
        <p class="hero-speed">Matched ~1 week · Live under ~2 weeks</p>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-amber">Get matched with your EA</a>
          <a href="#pricing" class="btn btn-ghost">See pricing</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-photo">
          <img src="/brand/ea-hero.jpg" alt="A dedicated virtual executive assistant in a modern office" fetchpriority="high" />
        </div>
        <div class="hero-chips">
          <div class="chip">
            <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
            <span class="cl"><b>English</b><br />&amp; Español</span>
          </div>
          <div class="chip">
            <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg></span>
            <span class="cl"><b>100%</b><br />U.S. time</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="false-strip" id="false">
    <div class="wrap">
      <div class="false-k">You’ve already tried the obvious ones</div>
      <div class="false-grid">
        {falseSolutions.map((s) => (
          <div class="false-card">
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="block" id="work">
    <div class="wrap reveal">
      <div class="eyebrow">What you can delegate</div>
      <h2 class="disp">Business ops. Off your plate.</h2>
      <p class="sub" style="max-width:64ch">
        Inbox, calendar, CRM, projects, vendors, business travel. Dedicated business leverage — not hour packs.
      </p>
      <div class="del-grid">
        {delegate.map((col) => (
          <div class="del-card">
            <h3>{col.h}</h3>
            <p class="del-lead">{col.p}</p>
            <ul>
              {col.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="mechanism" style="padding-top:0">
    <div class="wrap reveal">
      <div class="eyebrow">The mechanism</div>
      <h2 class="disp">Match how you operate. Onboard. Then it’s your EA.</h2>
      <p class="sub" style="max-width:64ch">
        We don’t send a resume stack. We match a dedicated bilingual executive assistant to how you think, communicate, and operate. You interview and select. We onboard. A partnership manager hands the seat off.
      </p>
      <p class="sub" style="max-width:64ch;margin-top:14px">
        After that, you run the relationship. Built for leaders who want a dedicated EA in their hours — bilingual, nearshore, predictable price.
      </p>
    </div>
  </section>

  <div class="howwrap">
    <section class="block" id="how">
      <div class="wrap reveal">
        <div class="eyebrow">Three steps</div>
        <h2 class="disp">Match. Onboard. You run your EA.</h2>
        <div class="steps">
          {steps.map(([t, b], i) => (
            <div class="step"><div class="num">0{i + 1}</div><h4>{t}</h4><p>{b}</p></div>
          ))}
        </div>
        <div class="mid-cta">
          <CtaBox
            heading="Get matched with your EA."
            body="Most clients are matched in about a week and live in under two. About 2–5 hours of your time. Then the seat is yours."
            label="Get matched with your EA"
            href="#contact"
          />
        </div>
      </div>
    </section>
  </div>

  <section class="customers-sec" id="customers">
    <div class="customers-wrap reveal">
      <div class="cust-pill">Our customers</div>
      <h2 class="disp">Built for U.S. leaders who need to delegate and see work done.</h2>

      <div class="proof-feature">
        <figure class="proof-portrait">
          <img
            src={featuredPortrait.img}
            alt={featuredPortrait.alt}
            width="900"
            height="1100"
            loading="lazy"
          />
        </figure>

        <blockquote class="t-card t-overlap">
          <p>“{proof.quote}”</p>
          <footer class="t-foot">
            <div>
              <div class="t-name">{proof.name}</div>
              <div class="t-role">{proof.company}</div>
            </div>
            <div class="t-avatar" aria-hidden="true">ES</div>
          </footer>
        </blockquote>
      </div>

      <aside class="t-card t-ink">
        <p>A dedicated bilingual EA on your U.S. hours — matched to how you operate, then handed to you.</p>
        <footer class="t-foot">
          <div>
            <div class="t-name">English &amp; Español</div>
            <div class="t-role">U.S. hours · matched ~1 week</div>
          </div>
          <a href="#contact" class="btn btn-amber t-cta">Get matched</a>
        </footer>
      </aside>
    </div>
  </section>

  <div class="howwrap">
    <section class="block" id="seat">
      <div class="wrap reveal">
        <div class="eyebrow">The partnership</div>
        <h2 class="disp">A dedicated seat that compounds. After handoff, it’s yours.</h2>
        <div class="pillar-grid">
          {pillars.map((p) => (
            <div class="pillar">
              <h3>{p.h}</h3>
              <p>{p.p}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <div class="trust-strip">
    <div class="wrap">
      <div class="trust-grid">
        <div><div class="tk">Background-checked</div><p>Career EAs. Multi-stage screen. Not gig help.</p></div>
        <div><div class="tk">Dedicated full-time</div><p>One named seat. Your hours. Bilingual EN/ES.</p></div>
        <div><div class="tk">You own the relationship</div><p>Match → onboard → handoff. We don’t babysit the seat.</p></div>
        <div><div class="tk">Rematch included</div><p>Wrong fit? We put someone else in the chair.</p></div>
      </div>
    </div>
  </div>

  <section class="block" id="failed">
    <div class="wrap reveal failed">
      <div class="eyebrow">Been here before</div>
      <h2 class="disp">“I tried a VA. Offshore. It failed.”</h2>
      <p class="sub" style="max-width:64ch">
        Timezone. Quality. Ownership. That’s the pattern: you explain it twice, correct it once, then do it yourself. A dedicated EA on your U.S. hours — matched to how you operate, then handed to you — is a different product.
      </p>
      <div class="hero-cta" style="margin-top:28px">
        <a href="#contact" class="btn btn-amber">Get matched with your EA</a>
      </div>
    </div>
  </section>

  <section class="block" id="proof" style="padding-top:0">
    <div class="wrap reveal">
      <div class="statpanel">
        {STATS.map((s) => (
          <div class="sp-cell">
            <div class="sp-n">{s.n}</div>
            <div class="sp-k">{s.k}</div>
            <div class="sp-sub">{STAT_SUB[s.n]}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="logos">
    <div class="lab">Trusted by global enterprises — 30-year operating history</div>
    <div class="marquee-mask">
      <div class="marquee">
        {marquee.map((name) => <span>{name}</span>)}
      </div>
    </div>
  </div>

  <div class="pricewrap">
    <section class="block" id="pricing">
      <div class="wrap reveal">
        <div class="eyebrow" style="justify-content:center">The seat</div>
        <h2 class="disp" style="text-align:center">One dedicated EA. ~$2.7–3k.</h2>
        <p class="sub" style="text-align:center;margin:0 auto">Full-time. Bilingual. Your hours. Start on 3 months. Switch to 12 and save $300/mo.</p>
        <div class="ea-tiers">
          <div class="ea-tier">
            <div class="ea-tier-tag">3-month</div>
            <div class="ea-amount"><span class="cur">$</span>{price3}<span class="per">/ mo</span></div>
            <div class="ea-tier-sub">3-month commitment</div>
            <a href="#contact" class="btn btn-amber ea-tier-btn">Get matched with your EA</a>
          </div>
          <div class="ea-tier feature">
            <div class="ea-best">Best value · save $300/mo</div>
            <div class="ea-tier-tag">12-month</div>
            <div class="ea-amount"><span class="cur">$</span>{price12}<span class="per">/ mo</span></div>
            <div class="ea-tier-sub">12-month commitment</div>
            <a href="#contact" class="btn btn-amber ea-tier-btn">Get matched with your EA</a>
          </div>
        </div>
        <p class="pricenote" style="text-align:center">{EA_CLOCK_NOTE}</p>
      </div>
    </section>
  </div>

  <section class="block" id="faq">
    <div class="wrap reveal">
      <div class="eyebrow">Questions</div>
      <h2 class="disp">The long version lives here.</h2>
      <p class="sub">Journey, 90-day clock, prepaid first month, rematch — straight answers.</p>
      <div class="ea-faq">
        {faq.map((f) => (
          <details class="ea-q">
            <summary>{f.q}<span class="pl">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0;padding-bottom:0">
    <div class="wrap reveal">
      <p class="cs-note">Need bilingual <a href="/customer-service">customer service</a> later? Same talent bench. Same U.S. hours. Available when you want it — it isn’t the product on this page. Longer EA argument: <a href="/ea/offer">see the offer</a>.</p>
    </div>
  </section>

  <BookingSection
    id="contact"
    eyebrow="Get matched"
    heading="Get matched with your EA."
    sub="We’ll match on how you think and operate. You interview and select. Most clients are matched in one week and live in under two. Then you own the relationship. The 90-day commitment starts on the official service start date."
    subject="New Teleforce EA match request"
    idPrefix="home"
  />

</BaseLayout>

<style>
  .hero h1.disp{font-size:clamp(28px,5.2vw,48px);text-transform:none;line-height:1.08;letter-spacing:-0.03em}
  .hero-inner{position:relative;z-index:2;max-width:1040px;margin:0 auto;padding:0 22px;
    display:grid;grid-template-columns:1.2fr 0.8fr;gap:48px;align-items:center}
  .hero-media{position:relative}
  .hero-photo{position:relative;border-radius:220px 220px 22px 22px;overflow:hidden;
    aspect-ratio:4/5;box-shadow:0 30px 60px -30px rgba(0,0,0,0.55);border:1px solid var(--line-dark)}
  .hero-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 18%;display:block}
  .hero-chips{position:absolute;left:50%;bottom:-18px;transform:translateX(-50%);
    display:flex;gap:0;background:rgba(9,28,30,0.86);backdrop-filter:blur(8px);
    border:1px solid var(--line-dark);border-radius:16px;padding:6px;box-shadow:0 16px 40px -18px rgba(0,0,0,0.6)}
  .hero-chips .chip{display:flex;align-items:center;gap:10px;padding:10px 18px}
  .hero-chips .chip + .chip{border-left:1px solid var(--line-dark)}
  .hero-chips .ci{display:flex;align-items:center;justify-content:center;width:34px;height:34px;
    border-radius:50%;background:rgba(242,168,43,0.15);color:var(--amber);flex-shrink:0}
  .hero-chips .ci svg{width:18px;height:18px}
  .hero-chips .cl{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.06em;
    text-transform:uppercase;color:var(--on-dark-mut);line-height:1.3}
  .hero-chips .cl b{color:#fff;font-weight:600}
  .hero-speed{margin-top:18px;font-family:'IBM Plex Mono',monospace;font-size:12px;
    letter-spacing:0.04em;color:var(--on-dark-mut);text-transform:uppercase}
  .hero .hero-cta{margin-top:22px}
  @media (max-width:820px){
    .hero-inner{grid-template-columns:1fr;gap:40px}
    .hero-media{max-width:400px;margin:0 auto;width:100%}
  }

  :global(.hero .wave){left:-3%;right:auto;width:56%;opacity:0.32}
  @media (max-width:820px){:global(.hero .wave){opacity:0.12;width:80%}}

  .false-strip{background:var(--ink-deep);color:var(--on-dark);padding:36px 0;border-top:1px solid var(--line-dark)}
  .false-k{font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:0.12em;text-transform:uppercase;
    color:var(--amber);margin-bottom:18px}
  .false-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .false-card{background:rgba(236,230,214,0.04);border:1px solid var(--line-dark);border-left:3px solid var(--amber);
    border-radius:0 12px 12px 0;padding:18px 16px}
  .false-card h3{font-family:'Archivo',sans-serif;font-weight:700;font-size:15.5px;letter-spacing:-0.01em;margin:0 0 8px;color:#fff}
  .false-card p{font-size:13.5px;color:var(--on-dark-mut);line-height:1.5;margin:0}
  @media (max-width:900px){.false-grid{grid-template-columns:1fr 1fr}}
  @media (max-width:540px){.false-grid{grid-template-columns:1fr}}

  .del-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:36px}
  .del-card{background:var(--paper);border:1px solid var(--line-paper);border-radius:16px;padding:28px 26px}
  .del-card h3{font-family:'Archivo',sans-serif;font-weight:700;font-size:20px;letter-spacing:-0.02em;margin-bottom:6px}
  .del-lead{font-size:14px;color:var(--on-paper-mut);margin-bottom:16px;line-height:1.45}
  .del-card ul{list-style:none;display:grid;gap:10px}
  .del-card li{position:relative;padding-left:16px;font-size:15px;color:var(--on-paper);line-height:1.45}
  .del-card li::before{content:"›";position:absolute;left:0;color:var(--amber);font-family:'IBM Plex Mono',monospace;font-weight:600}
  @media (max-width:700px){.del-grid{grid-template-columns:1fr}}

  .mid-cta{margin-top:40px}
  .mid-cta :global(.cta-box){margin:0}

  .customers-sec{
    padding:72px 0 88px;
    background:color-mix(in srgb, var(--sage) 10%, var(--paper));
  }
  .customers-wrap{max-width:480px;margin:0 auto;padding:0 24px}
  .cust-pill{
    display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10.5px;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--sage-deep);
    border:1px solid color-mix(in srgb, var(--sage-deep) 35%, transparent);
    border-radius:999px;padding:6px 12px;margin-bottom:18px;
  }
  .customers-sec h2.disp{
    font-weight:600;font-size:clamp(30px,7.6vw,42px);line-height:1.14;
    letter-spacing:-0.03em;text-transform:none;margin:0 0 36px;
  }
  .proof-feature{position:relative}
  .proof-portrait{margin:0;border-radius:18px;overflow:hidden;background:var(--paper-2)}
  .proof-portrait img{
    width:100%;aspect-ratio:4/5;object-fit:cover;object-position:50% 32%;display:block;
  }
  .t-card{
    margin:0;border-radius:18px;padding:28px 24px 22px;
    background:color-mix(in srgb, var(--sage) 14%, var(--paper));
  }
  .t-overlap{
    position:relative;z-index:1;margin:-32px 10px 0;
    box-shadow:0 18px 40px -28px rgba(14,38,41,0.45);
  }
  .t-card > p{
    font-family:'Archivo',sans-serif;font-weight:500;font-size:clamp(19px,4.6vw,23px);
    line-height:1.38;letter-spacing:-0.025em;color:var(--on-paper);
  }
  .t-foot{margin-top:32px;display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}
  .t-name{font-family:'Archivo',sans-serif;font-weight:600;font-size:15px;letter-spacing:-0.01em;color:var(--ink)}
  .t-role{
    font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:0.08em;
    text-transform:uppercase;color:var(--sage-deep);margin-top:5px;
  }
  .t-avatar{
    width:58px;height:58px;border-radius:12px;background:var(--ink);color:var(--amber);
    display:flex;align-items:center;justify-content:center;font-family:'Archivo',sans-serif;
    font-weight:800;font-size:15px;letter-spacing:0.04em;flex-shrink:0;
    box-shadow:0 8px 20px -12px rgba(14,38,41,0.5);
  }
  .t-ink{background:var(--ink);margin-top:14px}
  .t-ink > p{color:var(--on-dark)}
  .t-ink .t-name{color:#fff}
  .t-ink .t-role{color:var(--amber)}
  .t-cta{padding:10px 14px;font-size:11.5px;flex-shrink:0}
  @media (min-width:720px){
    .customers-sec{padding:88px 0 104px}
    .customers-wrap{max-width:520px;padding:0 28px}
    .customers-sec h2.disp{margin-bottom:44px}
    .t-overlap{margin-top:-40px;margin-left:14px;margin-right:14px}
    .t-card{padding:32px 28px 24px}
  }

  .pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:32px}
